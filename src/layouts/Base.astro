---
import '../styles/global.css';
import { navGroups, getProgram } from '../data/programs';
const { title = 'KunShineTech Academy', description = 'KunShineTech Academy 课程体系：GESP C++ 等级认证、CSP-J/S 备考、Python 编程、机器学习、软件工程与软件架构', level = 0, program = '' } = Astro.props;
const prog = program ? getProgram(program) : undefined;
const gespBase = level ? `/gesp/level/${level}` : '/gesp';
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title} · KunShineTech Academy</title><script is:inline>try{if(localStorage.getItem('kst-theme')==='light')document.documentElement.classList.add('light');}catch(e){}</script></head><body>
<header class="site-header"><div class="container header-inner"><a class="brand" href="/"><span class="logo">K.</span><span>KunShineTech <b>Academy</b></span></a><nav class="main-nav">{navGroups.map(g => (g.children.length === 1 && !(g.extra && g.extra.length)) ? <a class:list={{active:program===g.children[0].slug}} href={g.children[0].href}>{g.short}</a> : <div class:list={['nav-group', {active:g.children.some(c=>c.slug===program)||(g.extra||[]).some(e=>e.level===level)}]}><span class="nav-group-label">{g.short} ▾</span><div class="dropdown">{g.children[0] && <a class:list={{active:g.children[0].slug===program}} href={g.children[0].href}>{g.children[0].slug==='gesp'?'GESP 总览':g.children[0].nav}</a>}{(g.extra||[]).map(e=><a class:list={{active:e.level===level}} href={e.href}>{e.nav}</a>)}{g.children.slice(1).map(c=><a class:list={{active:c.slug===program}} href={c.href}>{c.nav}</a>)}{g.children[0] && g.children[0].slug==='gesp' && <><a href='/exams/'>真题模考</a><a href={level?`${gespBase}/roadmap`:'/gesp/'}>教学安排</a><a href={level?`${gespBase}/assessment`:'/gesp/'}>阶段测评</a></>}</div></div>)}</nav><button type="button" id="theme-toggle" class="theme-toggle" aria-label="切换明暗主题" style="flex:none">☀️</button></div>
</header>
<main><slot /></main><footer class="footer"><div class="container">KunShineTech Academy · {prog ? prog.title : '课程中心'} · 按 CCF 认证标准组织 · 教学扩展与官方要求分开标注</div></footer>
<script>
(function(){
  var btn = document.getElementById('theme-toggle');
  if (!btn) return;
  function apply(light, save){
    document.documentElement.classList.toggle('light', light);
    btn.textContent = light ? '\u{1F319}' : '\u2600\uFE0F';
    if (save) { try { localStorage.setItem('kst-theme', light ? 'light' : 'dark'); } catch(e){} }
    window.dispatchEvent(new Event('kst-theme'));
  }
  btn.addEventListener('click', function(){ apply(!document.documentElement.classList.contains('light'), true); });
  apply(document.documentElement.classList.contains('light'), false);
})();
</script>
</body></html>
