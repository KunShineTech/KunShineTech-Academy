---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { levels } from '../../data/levels';
import { resources, resourceKinds } from '../../data/resources';
const all = await getCollection('lessons');
const countOf = (lv: number) => all.filter((x) => x.data.level === lv).length;
const minutesOf = (lv: number) => all.filter((x) => x.data.level === lv).reduce((s, x) => s + x.data.duration, 0);
const list = resources['gesp'] ?? [];
---
<Base title="GESP C++ 等级认证" description="覆盖 GESP C++ 一至八级的互动课程，按 CCF 官方认证标准分级组织。" program="gesp"><div class="container"><section class="hero"><div class="eyebrow">CCF GESP · C++ PROGRAMMING · 2026</div><h1>选对级别，稳步进阶。</h1><p>GESP C++ 系列课程按 CCF 官方认证标准分级组织：一至三级建立编程基础与数组字符串功底，四级深入函数指针与排序递推，五级攻克数论与四大算法思想，六级攀登树、搜索与动态规划，七级进阶图论与复杂动态规划，八级登顶组合数学与算法优化。选择级别开始学习，可随时在顶部导航切换。</p><div class="stats"><div class="stat"><b>{levels.length}</b> 个级别</div><div class="stat"><b>{all.length}</b> 个主题单元</div><div class="stat"><b>{all.reduce((s, x) => s + x.data.duration, 0)}</b> 分钟建议授课</div><div class="stat"><b>60</b> 分通过线</div></div></section><h2 class="section-title" id="levels">选择级别</h2><div class="level-cards">{levels.map(l=><a class="level-card" href={`${import.meta.env.BASE_URL}/gesp/level/${l.level}/`}><span class="num">{l.code} · {l.syllabus.length} 项官方知识要求</span><h3>GESP C++ {l.cn}</h3><p>{l.tagline}{l.intro}</p><span class="meta">◷ {countOf(l.level)} 课 · {minutesOf(l.level)}分钟 · 进入课程 →</span></a>)}</div></div>{list.length > 0 && <div class="container" style="padding-bottom:80px"><h2 class="section-title">精选学习资源</h2><p style="color:var(--muted);font-size:14px">配套 GESP 学习的知名在线课程、刷题平台与经典图书（外部链接，以各站点实际内容为准）。</p>{resourceKinds.map((k) => { const items = list.filter((r) => r.kind === k); return items.length > 0 && <><h3 class="res-kind">{k}</h3><ul class="res-list">{items.map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.name}</a><span class="res-provider">{r.provider}</span><span class="res-note">{r.note}</span></li>)}</ul></> })}</div>}</Base>
