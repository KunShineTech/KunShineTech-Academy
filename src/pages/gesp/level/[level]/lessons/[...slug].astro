---
import Base from '../../../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { levels } from '../../../../../data/levels';
export async function getStaticPaths(){
  const all = await getCollection('lessons');
  return levels.flatMap((l) =>
    all.filter((x) => x.data.level === l.level).map((x) => ({
      params: { level: String(l.level), slug: x.id.split('/')[1] },
      props: { entry: x },
    }))
  );
}
const lv = Number(Astro.params.level);
const { entry } = Astro.props;
const all = (await getCollection('lessons')).filter((x) => x.data.level === lv).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((x) => x.id === entry.id);
const { Content } = await render(entry);
---
<Base title={entry.data.title} level={lv} program="gesp"><div class="container lesson-layout"><aside class="sidebar"><h3>GESP {levels.find(l=>l.level===lv)?.cn} · {all.length}个单元</h3>{all.map(x=><a class:list={{active:x.id===entry.id}} href={`/gesp/level/${lv}/lessons/${x.id.split('/')[1]}`}>{String(x.data.order).padStart(2,'0')} · {x.data.title}</a>)}</aside><article class="article"><div class="eyebrow">LESSON {String(entry.data.order).padStart(2,'0')} · {entry.data.unit}</div><h1>{entry.data.title}</h1><span class="pill">{entry.data.difficulty} · {entry.data.duration}分钟</span><div class="lesson-intro"><b>本课学习目标</b><ul>{entry.data.goals.map(g=><li>{g}</li>)}</ul></div><Content/><nav class="pager">{index > 0 ? <a href={`/gesp/level/${lv}/lessons/${all[index - 1].id.split('/')[1]}`}>← 上一课</a> : <a href={`/gesp/level/${lv}/`}>← 课程总览</a>}{index < all.length - 1 ? <a href={`/gesp/level/${lv}/lessons/${all[index + 1].id.split('/')[1]}`}>下一课 →</a> : <a href={`/gesp/level/${lv}/assessment`}>阶段测评 →</a>}</nav></article></div></Base>
