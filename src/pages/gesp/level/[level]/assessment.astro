---
import Base from '../../../../layouts/Base.astro';
import Check from '../../../../components/Check.astro';
import Task from '../../../../components/Task.astro';
import Reveal from '../../../../components/Reveal.astro';
import { levels } from '../../../../data/levels';
export function getStaticPaths() {
  return levels.map((l) => ({ params: { level: String(l.level) } }));
}
const lv = Number(Astro.params.level);
const info = levels.find((l) => l.level === lv)!;
const examLine = `${info.exam.choice}道单选（每题${info.exam.choiceScore}分）、${info.exam.judge}道判断（每题${info.exam.judgeScore}分）、${info.exam.programming}道编程（每题${info.exam.progScore}分），总时长${info.exam.duration}分钟`;
---
<Base title={`阶段测评 · GESP C++ ${info.cn}`} level={lv} program="gesp"><div class="container article" style="max-width:820px;padding:50px 0 80px"><div class="eyebrow">{info.code} · FINAL CHECK</div><h1>{info.cn}阶段测评与备考建议</h1><p>GESP C++ {info.cn}官方考纲规定：{examLine}。以下是教学自测示例，并非官方真题。</p>{info.quiz.map(q=><Check question={q.question} options={q.options} answer={q.answer} explanation={q.explanation}/>)}{info.problems.map((p, i)=><><h2>编程题 {String.fromCharCode(65 + i)} · {p.title}</h2><Task title={p.title} level={info.cn} time="25分钟" input={p.input} output={p.output} sampleIn={p.sampleIn} sampleOut={p.sampleOut}>{p.statement}</Task><Reveal label="查看参考程序与思路"><pre><code>{p.solution}</code></pre>{p.hint}</Reveal></>)}{info.advice.length > 0 && <><h2>教师评分建议</h2><ul>{info.advice.map(a=><li>{a}</li>)}</ul></>}</div></Base>
