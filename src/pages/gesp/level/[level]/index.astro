---
import Base from '../../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { levels } from '../../../../data/levels';
export function getStaticPaths() {
  return levels.map((l) => ({ params: { level: String(l.level) } }));
}
const lv = Number(Astro.params.level);
const info = levels.find((l) => l.level === lv)!;
const lessons = (await getCollection('lessons')).filter((x) => x.data.level === lv).sort((a, b) => a.data.order - b.data.order);
---
<Base title={info.title} description={info.intro} level={lv} program="gesp" toc={[{ text: '官方知识要求', slug: 'syllabus' }, { text: '课程目录', slug: 'catalog' }]}><div class="container"><section class="hero"><div class="eyebrow">CCF GESP · C++ {info.code} · 2026</div><h1>{info.tagline}</h1><p>{info.intro}</p><div class="stats"><div class="stat"><b>{lessons.length}</b> 个主题单元</div><div class="stat"><b>{lessons.reduce((s,x)=>s+x.data.duration,0)}</b> 分钟建议授课</div><div class="stat"><b>{info.syllabus.length}</b> 项官方知识要求</div><div class="stat"><b>{info.exam.duration}</b> 分钟认证考试</div></div>{lessons.length > 0 && <a class="primary-btn" href={`${import.meta.env.BASE_URL}/gesp/level/${lv}/lessons/${lessons[0].id.split('/')[1]}`}>开始第一课 →</a>}</section><h2 class="section-title" id="syllabus">官方知识要求</h2><ul>{info.syllabus.map((s) => <li>{s}</li>)}</ul><h2 class="section-title" id="catalog">课程目录</h2><div class="lesson-grid">{lessons.map(l=><a class="lesson-card" href={`${import.meta.env.BASE_URL}/gesp/level/${lv}/lessons/${l.id.split('/')[1]}`}><span class="num">LESSON {String(l.data.order).padStart(2,'0')} · {l.data.unit}</span><h3>{l.data.title}</h3><p>{l.data.goals.join(' · ')}</p><span class="meta">◷ {l.data.duration}分钟 · {l.data.difficulty}　→</span></a>)}</div></div></Base>
