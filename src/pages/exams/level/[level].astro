---
import Base from '../../../layouts/Base.astro';
import { levels } from '../../../data/levels';
const papers = import.meta.glob('../../../data/exams/*.json', { eager: true });
export function getStaticPaths() {
  return levels.map((l) => ({ params: { level: String(l.level) } }));
}
const lv = Number(Astro.params.level);
const cn = levels.find((l) => l.level === lv)!.cn;
const list = (Object.values(papers) as any[]).filter((p) => p.level === lv)
  .map((p) => ({ session: p.session, choice: p.choice.filter((c: any) => c.n <= 15 && !c.warn).length, judge: p.judge.filter((j: any) => j.n <= 10).length, prog: p.programming.length }))
  .sort((a, b) => (a.session < b.session ? 1 : -1));
---
<Base title={`${cn}真题模考 · GESP C++`}><div class="container" style="padding:48px 0 80px"><div class="eyebrow">MOCK EXAM · LEVEL {lv}</div><h1>GESP C++ {cn} · 真题列表</h1><p style="color:var(--muted);font-size:14px">共 {list.length} 套真题，按场次倒序排列。点击「在线模考」开始作答（单选 15×2 分 + 判断 10×2 分，即时评分）。</p><table class="exam-table"><thead><tr><th>场次</th><th>单选</th><th>判断</th><th>编程</th><th></th></tr></thead><tbody>{list.map((p) => <tr><td>{p.session.replace('-', ' 年 ')} 月</td><td>{p.choice}</td><td>{p.judge}</td><td>{p.prog}</td><td><a class="primary-btn" style="padding:6px 16px;font-size:13px" href={`${import.meta.env.BASE_URL}/exams/level/${lv}/${p.session}/`}>在线模考 →</a></td></tr>)}</tbody></table><p><a href={import.meta.env.BASE_URL + '/exams/'}>← 返回级别选择</a></p></div></Base>
