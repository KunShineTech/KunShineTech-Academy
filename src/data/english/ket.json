    "grammar": {
      "title": "语法精讲",
      "points": [
        {
          "title": "be 动词与人称搭配",
          "star": true,
          "explain": "be 动词有 am、is、are 三个'变身'。记住小口诀：'我用 am，你用 are，is 跟着他、她、它；复数名词全用 are。' 比如'我开心'是 I am happy，'她开心'是 She is happy，'他们开心'要用 They are happy。",
          "examples": [
            { "en": "I am a student.", "cn": "我是一名学生。" },
            { "en": "She is my friend.", "cn": "她是我的朋友。" },
            { "en": "They are in the classroom.", "cn": "他们在教室里。" }
          ],
          "tip": "最容易错的是 he/she/it 后面漏掉 is，写成 He tall 就错啦，一定要补上 is。"
        },
        {
          "title": "名词单复数",
          "star": true,
          "explain": "一个东西用单数，两个以上要在名词后面加 s 或 es。口诀：'一般加 s；s、x、ch、sh 结尾加 es；辅音字母加 y 结尾，变 y 为 i 再加 es。' 比如 one book → two books，one box → two boxes。",
          "examples": [
            { "en": "I have two dogs.", "cn": "我有两只狗。" },
            { "en": "There are three boxes.", "cn": "有三个盒子。" },
            { "en": "She has many storybooks.", "cn": "她有许多故事书。" }
          ],
          "tip": "以元音字母加 y 结尾的词直接加 s，如 boys、days，不要把 y 变成 i。"
        },
        {
          "title": "冠词 a / an / the",
          "star": true,
          "explain": "冠词就像名词的小帽子。a 用在以辅音音素开头的词前，an 用在以元音音素开头的词前，口诀：'元音开头 an 来陪，辅音开头 a 跟随。' the 是'特指帽子'，指特定的、双方都知道的那个，世上独一无二的东西也要戴 the，如 the sun。",
          "examples": [
            { "en": "I have an apple and a banana.", "cn": "我有一个苹果和一根香蕉。" },
            { "en": "This is the book I like.", "cn": "这是我喜欢的那本书。" },
            { "en": "The sun is big.", "cn": "太阳很大。" }
          ],
          "tip": "看的是读音开头而不是字母开头，如 an hour（h 不发音）、a university。"
        },
        {
          "title": "形容词与位置",
          "star": true,
          "explain": "形容词是名词的'化妆师'，专门描述人和东西的样子。在英语里，化妆师站在名词前面，要说 a red apple，不能说 an apple red。多个形容词排队时，先大小后颜色，如 a big red bag。",
          "examples": [
            { "en": "She has a cute cat.", "cn": "她有一只可爱的猫。" },
            { "en": "It is a tall tree.", "cn": "它是一棵高高的树。" },
            { "en": "I like the blue sky.", "cn": "我喜欢蓝色的天空。" }
          ],
          "tip": "形容词前面用 a 还是 an，要看形容词的第一个读音，如 an old man，不要只看后面的名词。"
        },
        {
          "title": "一般现在时",
          "star": true,
          "explain": "一般现在时表示'天天如此、总是这样'的事，常和 always、usually、every day 做朋友。主语是他/她/它时，动词要'穿上第三人称单数的小尾巴 s'，如 She likes…；其他人称用动词原形。",
          "examples": [
            { "en": "He plays football every day.", "cn": "他每天踢足球。" },
            { "en": "They live in Beijing.", "cn": "他们住在北京。" },
            { "en": "My mother cooks dinner at six.", "cn": "我妈妈六点做晚饭。" }
          ],
          "tip": "助动词 does 后面的动词要'脱掉尾巴'变回原形：Does he like…? 不能写成 Does he likes…?"
        },
        {
          "title": "现在进行时",
          "star": true,
          "explain": "现在正在发生的事，要用 be + 动词 ing。口诀：'正在做的事，be 和 ing 手拉手。' be 要随人称变身：I am reading，she is reading，they are reading。动词加 ing 前先看看末尾：以不发音 e 结尾要去 e 再加 ing，如 make → making。",
          "examples": [
            { "en": "I am doing my homework now.", "cn": "我现在正在做作业。" },
            { "en": "Look! The bird is flying.", "cn": "看！那只鸟正在飞。" },
            { "en": "They are playing basketball.", "cn": "他们正在打篮球。" }
          ],
          "tip": "看到 now、look、listen 这些信号词，就该用现在进行时，千万别写成 play 原形。"
        },
        {
          "title": "一般过去时（be 与规则动词）",
          "star": true,
          "explain": "说昨天和过去的事，动词要'时光倒流'。be 动词变成 was 或 were，口诀：'单数 was，复数 were，我用 was 你也行。' 规则动词一般在后面加 ed，如 play → played，like → liked。",
          "examples": [
            { "en": "I was at home yesterday.", "cn": "昨天我在家。" },
            { "en": "They were happy last week.", "cn": "上周他们很开心。" },
            { "en": "We visited the zoo last Sunday.", "cn": "上周日我们参观了动物园。" }
          ],
          "tip": "一般过去时的否定句和疑问句要请 did 帮忙，did 出现后动词变回原形：Did you go…? 不能写成 Did you went…?"
        },
        {
          "title": "情态动词 can",
          "star": true,
          "explain": "can 表示'能、会'，是个热心肠的小帮手，后面的动词永远用原形，口诀：'can 后跟原形，谁也不能带尾巴。' 否定句在 can 后加 not（cannot / can't），疑问句把 can 提到句首。",
          "examples": [
            { "en": "I can swim.", "cn": "我会游泳。" },
            { "en": "She can dance very well.", "cn": "她跳舞跳得很好。" },
            { "en": "Can you ride a bike?", "cn": "你会骑自行车吗？" }
          ],
          "tip": "不要写成 can to swim 或 can swimming，can 后面只能接动词原形。"
        },
        {
          "title": "祈使句与 let's",
          "star": true,
          "explain": "命令、请求、建议别人做某事时，用祈使句：动词直接站在句首当'排头兵'，如 Open the door，句首不用加主语 you。let's 是 let us 的缩写，意思是'让我们一起……'，后面同样接动词原形。",
          "examples": [
            { "en": "Open your books, please.", "cn": "请打开你们的书。" },
            { "en": "Don't run in the classroom.", "cn": "不要在教室里跑。" },
            { "en": "Let's play football after school.", "cn": "放学后我们一起踢足球吧。" }
          ],
          "tip": "祈使句的否定要在动词前加 Don't，如 Don't be late，不要把 not 放在动词后面。"
        },
        {
          "title": "there be 句型",
          "star": true,
          "explain": "想说'某地有某物'，就用 there be 句型，口诀：'有某物，there be，单数 is 复数 are。' be 动词和谁靠得近就听谁的，这叫'就近原则'：There is a pen and two books…，但 There are two books and a pen…。",
          "examples": [
            { "en": "There is a cat under the chair.", "cn": "椅子下面有一只猫。" },
            { "en": "There are thirty students in my class.", "cn": "我们班有三十名学生。" },
            { "en": "There is a desk and two chairs in the room.", "cn": "房间里有一张桌子和两把椅子。" }
          ],
          "tip": "there be 不能和 have 混用，'教室里有四十张桌子'是 There are forty desks in the classroom，不能说 The classroom has forty desks。"
        },
        {
          "title": "方位介词",
          "star": true,
          "explain": "方位介词是名词的'位置指示牌'。口诀：'里面 in，上面 on，下面 under 记心间；前面 in front of，后面 behind 别弄反；旁边 next to，中间 between。' 比如书在包里是 in the bag，书在桌上是 on the desk。",
          "examples": [
            { "en": "The ball is under the table.", "cn": "球在桌子下面。" },
            { "en": "The library is next to the school.", "cn": "图书馆在学校旁边。" },
            { "en": "There is a garden in front of the house.", "cn": "房子前面有一个花园。" }
          ],
          "tip": "in front of 和 in the front of 不一样：前者在物体外部的前面，后者在物体内部的前面，如司机坐在汽车前部是 in the front of the bus。"
        },
        {
          "title": "疑问词与特殊疑问句",
          "star": true,
          "explain": "特殊疑问句由疑问词打头，像七个小侦探：who 问人，what 问事和物，where 问地点，when 问时间，why 问原因，how 问方式，how many 问数量。句子结构是'疑问词 + 一般疑问句'，口诀：'疑问词站排头，be 动词跟着走。'",
          "examples": [
            { "en": "Where is your schoolbag?", "cn": "你的书包在哪里？" },
            { "en": "What do you do on Sundays?", "cn": "你星期天做什么？" },
            { "en": "How many books do you have?", "cn": "你有多少本书？" }
          ],
          "tip": "用 how many 提问时，后面的名词要用复数：How many dogs? Two."
        }
      ]
    },
    "writing": {
      "title": "写作指导",
      "types": [
        {
          "name": "便条 / 留言",
          "guide": "便条通常只有三要素：称呼（如 Dear Mum）、正文、署名。正文要用一两句话写清'什么事、什么时间、什么地点'，句子要短，时态以一般现在时和将来时（will）为主。称呼顶格写，署名和日期放在右下角。",
          "template": "Dear _____,\nI am going to _____ this afternoon.\nI will be back at _____.\nPlease don't worry about me.\nSee you!\n_____",
          "sample": {
            "title": "范文：给妈妈的留言",
            "text": "Dear Mum,\nI go to the library with Lily this afternoon.\nWe read books and do our homework there.\nI will be back at five o'clock.\nPlease don't worry about me.\nThere is some juice in the fridge.\nYou can have it after work.\nSee you later!\nTom",
            "notes": "范文简单交代了去哪、和谁、几点回来，信息完整不啰嗦；用 will be back 表示'将回来'，符合 A2 水平，落款规范。"
          }
        },
        {
          "name": "邀请卡回复",
          "guide": "收到邀请卡后，回复要先感谢对方，再写清自己是否参加。常用句：Thank you for your invitation. / I would love to come. 如果去不了，要说 Sorry, I can't，并简单说明原因。结尾用 I can't wait to see you! 表达期待。",
          "template": "Dear _____,\nThank you for your invitation.\nI would love to come to your _____.\nThe party is on _____ at _____.\nI will bring _____ with me.\nI can't wait to see you!\nLove,\n_____",
          "sample": {
            "title": "范文：回复生日聚会邀请",
            "text": "Dear Amy,\nThank you for your invitation.\nI would love to come to your birthday party.\nThe party is on Saturday at three o'clock.\nI will bring my new camera with me.\nWe can take many photos together.\nI also have a small gift for you.\nI can't wait to see you!\nLove,\nLily",
            "notes": "回复先谢后答，聚会的时间和地点复述得很清楚；还主动写了'带相机、送礼物'，让内容更丰满，容易得高分。"
          }
        },
        {
          "name": "失物招领",
          "guide": "寻物启事（LOST）要写清四件事：丢失的物品、时间地点、物品特征、联系方式。如果是招领启事（FOUND），则写捡到的东西和认领地点。结尾别忘了写 Thank you very much! 和署名。",
          "template": "LOST\nI lost my _____ on _____.\nIt is _____ and _____.\nThere is _____ in it.\nIf you find it, please call me at _____.\nThank you very much!\n_____",
          "sample": {
            "title": "范文：寻物启事",
            "text": "LOST\nI lost my blue schoolbag on the playground this morning.\nIt is big and new.\nThere are three books and a pencil box in it.\nMy name card is in the bag, too.\nIf you find it, please call me at 123456 or give it to Miss Li.\nThank you very much!\nWang Ming",
            "notes": "范文把物品、时间地点、特征、联系方式写得明明白白；用 there be 句型描述包里有什么，句式多样，值得学习。"
          }
        },
        {
          "name": "日程介绍",
          "guide": "介绍自己的一天时，按时间顺序写，常用 first、then、in the afternoon、after dinner 这些'路标词'带路。动词用一般现在时，注意第三人称单数。最后写一句感受，如 I am busy but happy!，让文章有头有尾。",
          "template": "My Day\nI get up at _____ every morning.\nThen I _____ at _____.\nI have _____ at _____.\nIn the afternoon, I _____.\nAfter dinner, I _____.\nI go to bed at _____.\nThis is my day. I am happy every day!",
